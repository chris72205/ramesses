# Backend
PORT=3000
DATABASE_URL=postgres://ramesses:ramesses@localhost:5433/ramesses
REDIS_URL=redis://localhost:6380
# Set to the built web app directory to serve it from the backend (production)
# WEB_DIST=../web/dist
# Rolling bandwidth metrics kept in Redis
METRICS_RETENTION_SEC=900
METRICS_WINDOW_SEC=300
# Tracker project sampling (runs on the one replica holding the Redis leader key)
PROJECTS_SAMPLING_ENABLED=true
PROJECTS_SAMPLE_INTERVAL_SEC=900
PROJECTS_RETENTION_DAYS=90
PROJECTS_REFRESH_MIN_SEC=300
# TRACKER_PROJECTS_URL=https://warriorhq.archiveteam.org/projects.json
# TRACKER_STATS_URL_TEMPLATE=https://v1.api.tracker.archiveteam.org/{name}/stats.json
# Leader election across server replicas
# REDIS_KEY_PREFIX=ramesses
# LEADER_TTL_MS=30000
# LEADER_RENEW_MS=10000
