{
  "name": "@ramesses/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "migration:run": "nest build && node dist/database/migrate.js",
    "migration:revert": "nest build && node dist/database/migrate.js revert",
    "test:unit": "vitest run --config vitest.config.mts --project unit",
    "test:integration": "vitest run --config vitest.config.mts --project integration",
    "test:e2e": "vitest run --config vitest.config.mts --project e2e"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@nestjs/platform-ws": "^12.3.3",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.3.3",
    "@ramesses/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@types/pg": "^8.15.0"
  }
}
