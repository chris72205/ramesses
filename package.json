{
  "name": "ramesses",
  "private": true,
  "version": "0.1.0",
  "description": "Fleet dashboard for Archive Team Warrior instances",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @ramesses/shared build",
    "test": "pnpm build:shared && vitest run",
    "test:coverage": "pnpm build:shared && vitest run --coverage",
    "test:e2e": "pnpm --filter @ramesses/web test:e2e",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm build:shared && eslint .",
    "lint:fix": "pnpm build:shared && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  },
  "type": "module"
}
